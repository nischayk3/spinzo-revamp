{
  "name": "@spinzo/firebase-backup",
  "version": "1.0.0",
  "description": "Secure local backup tool for Spinzo Firebase (Firestore + Auth)",
  "private": true,
  "type": "module",
  "scripts": {
    "backup": "node backup.js",
    "backup:firestore": "node backup.js --only=firestore",
    "backup:auth": "node backup.js --only=auth",
    "restore:firestore": "node restore.js",
    "verify": "node verify-backup.js"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0"
  }
}
